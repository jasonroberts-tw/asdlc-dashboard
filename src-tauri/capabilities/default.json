{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the board windows: the first is main, the others board-N",
  "windows": ["main", "board-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "dialog:allow-open"
  ]
}
